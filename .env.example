# Copy to .env and fill in. Never commit .env.
# Set ONE of the two keys below (OpenAI or Google Gemini).

# auto = OpenAI if OPENAI_API_KEY is set, otherwise Gemini if GEMINI_API_KEY is set
LLM_PROVIDER=auto

# --- Google Gemini (get a key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional backup keys: if a key is rejected or its quota is used up, the next one is used automatically.
# (OPENAI_API_KEY_2 ... works the same way; a comma-separated GEMINI_API_KEYS=k1,k2 is also accepted.)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Any Gemini model available to your key, e.g. gemini-3.5-flash, gemini-3.8-flash, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenAI ---
OPENAI_API_KEY=
# Any OpenAI model that supports Structured Outputs (JSON schema), e.g. gpt-4.1-mini, gpt-4.1, gpt-4o
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3
# Slow retries when the provider says "quota exceeded" (429) or "overloaded" (503)
LLM_BUSY_RETRIES=2
LLM_BUSY_WAIT_SECONDS=20
# Optional: OpenAI-compatible endpoint (e.g. Azure/OpenAI proxy)
# OPENAI_BASE_URL=

# auto = use the LLM when a key is set, else rule-based fallback; rule-based = never call the LLM
EXTRACTION_MODE=auto
# Characters of page text per LLM call; longer invoices are split by page
LLM_MAX_CHARS_PER_CALL=24000

# OCR (Tesseract). Install with: brew install tesseract   (extra languages: brew install tesseract-lang)
OCR_LANG=eng
OCR_DPI=300
OCR_IMAGE_REGIONS=true
MAX_PAGES=50
